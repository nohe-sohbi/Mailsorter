# Edition: "self-hosted" (the default when unset) or "hosted"
# Not a packaging label: it decides which mailbox providers this instance may
# offer, so the boot REFUSES an unrecognised value rather than guessing.
#   self-hosted  you run this instance and own the credentials. You can use your
#                own Google Cloud project, which places you inside Google's
#                personal-use exemption: full Gmail API, no verification, no
#                security assessment, no user cap. Proton is offered too, through
#                its local Bridge (127.0.0.1:1143), which the backend reaches only
#                when it runs on the same machine as Bridge (go run, not Docker).
#   hosted       the managed service. A single shared OAuth client is capped by
#                Google at 100 authorizations for the LIFETIME of the Cloud
#                project, so the Gmail API route is unavailable at any price:
#                Gmail is reached over IMAP with an app password instead, and
#                Proton is unreachable.
# The full matrix of providers, transports and credentials is in
# backend/internal/provider/catalog.go.
EDITION=self-hosted

# Which look Mailsorter wears. "hotel" is the Grand Hotel theme (landing,
# dashboard and the HTML of the daily digest email), "classic" the look that
# predates it, kept intact. Read by the backend and served by
# GET /api/config/status, so switching needs a backend restart, never a
# rebuild. ?ui=hotel or ?ui=classic previews the other one for one tab.
# Anything else stops the boot.
UI_THEME=hotel

# MongoDB Configuration
# MONGO_ROOT_* seed the Mongo container; docker-compose derives MONGODB_URI from
# them for the backend. Running the backend directly (go run) instead? Set
# MONGODB_URI yourself: it defaults to
# mongodb://admin:password@localhost:27017/mailsorter?authSource=admin.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
# MONGODB_URI=mongodb://admin:password@localhost:27017/mailsorter?authSource=admin

# Ports on your machine (make up). The containers always listen on their own
# fixed ports; these only move the host side, for when one is already taken.
BACKEND_PORT=8080
FRONTEND_PORT=3000
# MONGO_PORT=27017
# For a direct `go run`, the backend reads PORT instead (defaults to 8080).
# PORT=8080

# Encryption key for storing sensitive data (REQUIRED, min 32 characters)
# It seals every credential stored per user (Gmail OAuth tokens, IMAP app
# passwords, personal AI keys; AES-256-GCM), and it signs the session tokens
# and the OAuth state. The server REFUSES to start without it, or with this
# placeholder or the README's.
# CHANGING IT LATER LOGS EVERYONE OUT and makes every stored credential
# unreadable, so every user has to reconnect. There is no rotation path.
# generate a real one, e.g.:  openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-a-secure-random-string-32chars

# Gmail API (OPTIONAL)
# Only for the full Gmail API route. Without them, Gmail still connects over
# IMAP with an app password. Meant for an instance you run for yourself:
# Google caps the authorizations of such an OAuth client at 100 for the life
# of the Cloud project, which is why the hosted service leaves them empty.
# Get them from https://console.cloud.google.com/
# One OAuth app is shared by every account on the instance, so these are a
# deployment setting: there is no UI and no API to change them at runtime.
# GMAIL_REDIRECT_URL must match an authorized redirect URI declared in the
# Google Cloud project, exactly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URL=http://localhost:3000/auth/callback

# AI Providers & Fallback Configuration
# Multi-provider architecture with automatic fallback on rate limits (429) or downtime.
# Users can also bring their own key (BYOK) directly in Settings.
# All of these reach the backend with `make up` (compose.local.yml) or `go run`.
# The deployment's docker-compose.yml forwards MISTRAL_* only.

# Mistral AI (Default primary provider)
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Extra retry attempts on transient AI failures (429/5xx/network), after the
# first try. Backoff is exponential with jitter and honors Retry-After. Default 2.
MISTRAL_MAX_RETRIES=2

# OpenAI / OpenAI-compatible (Groq, Together, vLLM, llama.cpp, LM Studio...)
# OPENAI_BASE_URL is the FULL chat completions URL, e.g.
# http://host.docker.internal:1234/v1/chat/completions for LM Studio. A local
# server ignores the key, but it must not be empty for the provider to load.
# When MISTRAL_API_KEY hits 429, automatically falls back to OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Ollama (Local self-hosted AI - zero external API cost, no email leaves the machine)
# Setting OLLAMA_MODEL is enough. Leave MISTRAL_API_KEY empty to run fully local.
# With `make up`, the default URL reaches an Ollama on the same machine
# (host.docker.internal). Ollama must then listen beyond loopback: OLLAMA_HOST=0.0.0.0.
# For Ollama on another machine, put its address. See "IA locale" in the README.
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: Preferred fallback provider name (mistral, openai, anthropic, ollama)
# AI_FALLBACK_PROVIDER=openai

# Stripe Billing (Optional - Pro = unlimited analyses)
# Leave STRIPE_SECRET_KEY empty to keep the Pro CTA on the waitlist flow.
# Get keys at https://dashboard.stripe.com/apikeys, create a recurring Price,
# and add a webhook endpoint -> {backend}/api/billing/webhook (signing secret below).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Base URL of the frontend, used for Checkout success/cancel redirects.
APP_BASE_URL=http://localhost:3000

# Observability
# Reported by GET /health and GET /metrics so you can tell which build is live
# (e.g. a git short SHA injected at deploy time). Defaults to "dev".
BUILD_VERSION=dev

# Daily email digest
# Default hour of day (UTC, 0-23) at which the daily recap is sent to users who
# opted in (each user can override it in Réglages). Default 7.
DIGEST_HOUR_UTC=7

# CORS allow-list (comma-separated origins allowed to call the API).
# Leave empty to use the built-in defaults (localhost dev + mailsorter.sohbi.dev).
# Set this when deploying on another domain, no rebuild required.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://example.com
ALLOWED_ORIGINS=

# Analytics (Umami, self-hosted on analytics.sohbi.dev)
# Website id for this deployment. Like REACT_APP_API_URL below, it is inlined
# into the static bundle AT BUILD TIME, so it must be provided as a build arg,
# not only as a runtime env var. Leave empty to disable tracking entirely.
# The tracker only collects on the host declared in the frontend analytics
# module, so local builds never pollute the stats.
REACT_APP_UMAMI_WEBSITE_ID=

# Frontend Configuration
# Absolute URL of the API, baked into the static build at image build time.
# Leave this UNSET (commented) so both flows work out of the box:
#   - Docker / Dokploy build  -> defaults to "/" (same-origin via the nginx
#     proxy, location /api -> backend:8080; no CORS, no host-specific build)
#   - local `npm start` (make frontend) -> api.js falls back to localhost:8080
# Uncomment and set a full URL only if the API lives on a different origin.
#REACT_APP_API_URL=/
