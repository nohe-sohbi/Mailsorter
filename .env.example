# Edition (REQUIRED, "self-hosted" or "hosted"; defaults to self-hosted)
# Not a packaging label: it decides which mailbox providers this instance may
# offer, so the boot REFUSES an unrecognised value rather than guessing.
#   self-hosted  you run this instance and own the credentials. You can use your
#                own Google Cloud project, which places you inside Google's
#                personal-use exemption: full Gmail API, no verification, no
#                security assessment, no user cap. Proton works too, through a
#                local Bridge on this machine.
#   hosted       the managed service. A single shared OAuth client is capped by
#                Google at 100 authorizations for the LIFETIME of the Cloud
#                project, so the Gmail API route is unavailable at any price:
#                Gmail is reached over IMAP with an app password instead, and
#                Proton is unreachable.
# The full matrix of providers, transports and credentials is in
# backend/internal/provider/catalog.go.
EDITION=self-hosted

# MongoDB Configuration
# MONGO_ROOT_* seed the Mongo container; docker-compose derives MONGODB_URI from
# them for the backend. Running the backend directly (go run) instead? Set
# MONGODB_URI yourself: it defaults to
# mongodb://admin:password@localhost:27017/mailsorter?authSource=admin.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
# MONGODB_URI=mongodb://admin:password@localhost:27017/mailsorter?authSource=admin

# Backend Configuration
# docker-compose maps BACKEND_PORT to the container's PORT. For a direct
# `go run`, the backend reads PORT (defaults to 8080).
BACKEND_PORT=8080
# PORT=8080

# Encryption key for storing sensitive data (REQUIRED, min 32 characters)
# Three secrets in one: it encrypts the Gmail OAuth tokens stored per user
# (AES-256-GCM), and it signs both the session tokens and the OAuth state.
# The server REFUSES to start with this placeholder or the built-in default.
# CHANGING IT LATER LOGS EVERYONE OUT and orphans every stored Gmail token, so
# every user has to reconnect their account. There is no rotation path.
# generate a real one, e.g.:  openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-a-secure-random-string-32chars

# Gmail API Configuration (REQUIRED)
# Get these from Google Cloud Console: https://console.cloud.google.com/
# One OAuth app is shared by every account on the instance, so these are a
# deployment setting: there is no UI and no API to change them at runtime.
# GMAIL_REDIRECT_URL must match an authorized redirect URI declared in the
# Google Cloud project, exactly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URL=http://localhost:3000/auth/callback

# Mistral AI Configuration
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Extra retry attempts on transient AI failures (429/5xx/network), after the
# first try. Backoff is exponential with jitter and honors Retry-After. Default 2.
MISTRAL_MAX_RETRIES=2

# Stripe Billing (Optional - Pro = unlimited analyses)
# Leave STRIPE_SECRET_KEY empty to keep the Pro CTA on the waitlist flow.
# Get keys at https://dashboard.stripe.com/apikeys, create a recurring Price,
# and add a webhook endpoint -> {backend}/api/billing/webhook (signing secret below).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Base URL of the frontend, used for Checkout success/cancel redirects.
APP_BASE_URL=http://localhost:3000

# Observability
# Reported by GET /health and GET /metrics so you can tell which build is live
# (e.g. a git short SHA injected at deploy time). Defaults to "dev".
BUILD_VERSION=dev

# Daily email digest
# Default hour of day (UTC, 0-23) at which the daily recap is sent to users who
# opted in (each user can override it in Réglages). Default 7.
DIGEST_HOUR_UTC=7

# CORS allow-list (comma-separated origins allowed to call the API).
# Leave empty to use the built-in defaults (localhost dev + mailsorter.sohbi.dev).
# Set this when deploying on another domain, no rebuild required.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://example.com
ALLOWED_ORIGINS=

# Analytics (Umami, self-hosted on analytics.sohbi.dev)
# Website id for this deployment. Like REACT_APP_API_URL below, it is inlined
# into the static bundle AT BUILD TIME, so it must be provided as a build arg,
# not only as a runtime env var. Leave empty to disable tracking entirely.
# The tracker only collects on the host declared in the frontend analytics
# module, so local builds never pollute the stats.
REACT_APP_UMAMI_WEBSITE_ID=

# Frontend Configuration
# Absolute URL of the API, baked into the static build at image build time.
# Leave this UNSET (commented) so both flows work out of the box:
#   - Docker / Dokploy build  -> defaults to "/" (same-origin via the nginx
#     proxy, location /api -> backend:8080; no CORS, no host-specific build)
#   - local `npm start` / dev-start.sh -> api.js falls back to localhost:8080
# Uncomment and set a full URL only if the API lives on a different origin.
#REACT_APP_API_URL=/
